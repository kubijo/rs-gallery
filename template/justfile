# Standalone justfile for a gallery instance — no dependency on a parent workspace.

# Bare `just` lists recipes instead of running the first one.
[private]
default:
    @just --list

# Run the component gallery.
run:
    cargo run

# Run the gallery with live hot-reload — rebuilds + hot-swaps scenes as you edit them.
hot:
    cargo run -- --hot

# Check whether a newer `gallery` is out and list what changed since your version.
update:
    cargo run -- --check-updates

# Render SCENE's canvas to OUT as a PNG, at its default knobs — no window.
render SCENE OUT SIZE="1280x720":
    cargo run --quiet -- --scene {{ SCENE }} --render {{ OUT }} --size {{ SIZE }}

# Render every shot in a capture recipe (render with knobs set).
capture FILE="capture.toml" OUT="":
    cargo run --quiet -- --capture {{ FILE }} {{ if OUT == "" { "" } else { "--out " + OUT } }}

# List SCENE's knobs, their kinds and their values — the labels a capture recipe sets.
knobs SCENE:
    cargo run --quiet -- --scene {{ SCENE }} --list-knobs

# Print a capture recipe for SCENE with its knobs filled in — redirect it into a file to start one.
capture-init SCENE:
    cargo run --quiet -- --scene {{ SCENE }} --init-capture
